# ==============================================================================
# Global .gitignore for Agencia VDV (Django + React)
# ==============================================================================

# --- OS Specific ---
.DS_Store
Thumbs.db
*.swp
*.bak

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp

# --- Node.js / React / Vite ---
node_modules/
dist/
dist-ssr/
*.local
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
# Virtual environments
.venv/

# Django specific
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
# No ignoramos static/ si contiene archivos fuente, 
# pero ignoramos la carpeta de salida de collectstatic si se llama static_root

# --- Environment Variables ---
.env
.env.*
!.env.example

# --- Logs & Database ---
*.log
*.sql
*.dump

# --- Others ---
.git-rewrite
.idea/
.vscode/
